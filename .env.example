# Copie este archivo como .env.local (NUNCA lo suba a Git).

# --- Públicas (van al JavaScript del navegador: solo la configuración web de Firebase) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Opcional: URL pública para metadatos y sitemap (en Vercel se detecta sola)
NEXT_PUBLIC_SITIO_URL=

# --- Solo servidor (secretos) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Con \n literales; la app los convierte en saltos de línea al iniciar
FIREBASE_PRIVATE_KEY=
BLOB_READ_WRITE_TOKEN=
